    "h": 10,
    "text": "01"
  },
  {
    "page": 1,
    "x": 75.0,
    "y": 291,
    "w": 113.14062500000001,
    "h": 13,
    "text": "변화하는 금융 선택"
  },
  {
    "page": 1,
    "x": 50.0,
    "y": 321,
    "w": 219.29658792650923,
    "h": 32,
    "text": "진학·취업·주거 변화는<br/>금융기관 선택을 다시 검토할 계기."
